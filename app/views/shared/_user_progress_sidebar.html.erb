<%= turbo_frame_tag "comic_progress", class: "col-span-2 sm:border-l-2 sm:border-black" do %>
  <div class="sticky top-0 sm:max-h-screen sm:h-fit overflow-scroll flex-col gap-4 p-4 no-scrollbar flex">
    <%= render ProfileChipComponent.new(user: current_user) %>
    <% current_user.incompleted_comics.each do |comic| %>
      <%= render ComicProgressComponent.new(comic:, current_user:) %>
    <% end %>
  </div>
<% end %>
